{
  "name": "@noldova/checkpoints",
  "version": "0.0.4",
  "description": "The checkpoints module for apps on Noldova Desktop: it keeps a folder's files at chosen moments with its own Git and lists them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/checkpoints.git",
    "directory": "src/noldova.checkpoints"
  },
  "homepage": "https://github.com/noldova-com/checkpoints#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/checkpoints/issues"
  },
  "exports": {
    "./runtime": "./src/api/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "module.json",
    "settings.json",
    "src/**/*.js",
    "src/**/*.js.map",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@noldova/context.core": ">=0.0.12 <0.1.0",
    "@noldova/context.exceptions": ">=0.0.12 <0.1.0",
    "@noldova/context.json": ">=0.0.12 <0.1.0",
    "@noldova/desktop.protocol": ">=0.0.17 <0.1.0",
    "@noldova/desktop.runtime": ">=0.0.17 <0.1.0"
  },
  "noldova": {
    "packageDependencies": [
      "@noldova/checkpoints.protocol"
    ],
    "optionalPackageDependencies": [
      "@noldova/checkpoints.git.darwin-arm64",
      "@noldova/checkpoints.git.darwin-x64",
      "@noldova/checkpoints.git.linux-arm64",
      "@noldova/checkpoints.git.linux-x64",
      "@noldova/checkpoints.git.win32-arm64",
      "@noldova/checkpoints.git.win32-x64"
    ]
  }
}
